(text "USB Hub and Downstream Ports" (at 12 15 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid "1b4c7b24-548d-558c-848a-4fdd055efaac"))
(text "Named nets connect the circuit blocks on this sheet and across the hierarchy." (at 12 23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6d38520c-46bf-5149-8ce3-69748ff26d94"))
(text "USB7206C - six downstream ports" (at 12.0 45 0) (effects (font (size 2 2)) (justify left top)) (uuid "6350700d-f984-5061-ae70-a2e01537bcc6"))
(text "Port 1/2: Type-C. Ports 3/4/5: Type-A SuperSpeed. Port 6: Type-A USB 2.0.\nConfiguration 3 per DS00003850F Tables 3-4/3-5. RESET and VBUS_DET driven by PD MCU, not high-voltage VBUS." (at 12.0 52 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "ec27fc30-efd0-5156-8fbb-945489ca75a3"))
(text "Hub decoupling and transmit coupling" (at 596.2 45 0) (effects (font (size 2 2)) (justify left top)) (uuid "1c50fb65-8d0f-5756-86c7-55320f2178fd"))
(text "One 100 nF capacitor per VDD33/VCORE pin, placed at the relevant pin. Bulk capacitors near hub.\n220 nF series capacitors on each hub SuperSpeed TX lane only. Route 90 ohm differential pairs without stubs." (at 596.2 52 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "8774caaf-4707-567a-98b1-aa2b74586d2e"))
(text "Downstream Type-C 1 - 5 V / 3 A" (at 596.2 329.5 0) (effects (font (size 2 2)) (justify left top)) (uuid "4319a80a-34f6-589c-9a65-ef54e769ce01"))
(text "HD3SS3220 GPIO mode: ADDR open, PORT high, CURRENT_MODE 10k to 5 V.\nVBUS enable = hub PRT_CTL AND attached. DIR has required 200k pull-up. eFuse nominal 3.27 A, latch-off." (at 596.2 336.5 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "37cb8871-00a6-55bb-9255-713ca6d04ed3"))
(text "Downstream Type-C 2 - 5 V / 3 A" (at 12.0 418.4000000000001 0) (effects (font (size 2 2)) (justify left top)) (uuid "a19d7b6f-8395-5b16-9930-2e1cb6b413ee"))
(text "HD3SS3220 GPIO mode: ADDR open, PORT high, CURRENT_MODE 10k to 5 V.\nVBUS enable = hub PRT_CTL AND attached. DIR has required 200k pull-up. eFuse nominal 3.27 A, latch-off." (at 12.0 425.4000000000001 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "c74bd8de-5e08-551c-9b46-bfbedc7f01dc"))
(text "Downstream Type-A 1 - SuperSpeed / 900 mA" (at 596.2 649.54 0) (effects (font (size 2 2)) (justify left top)) (uuid "6c4aec92-20a1-52bf-a27a-4c76b167918d"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 596.2 656.54 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "f05176e4-c071-5d53-9d16-36ccb64891e1"))
(text "Downstream Type-A 2 - SuperSpeed / 900 mA" (at 12.0 738.44 0) (effects (font (size 2 2)) (justify left top)) (uuid "6c055307-5846-54a3-b3ba-8f5bdc55ec2c"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 12.0 745.44 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "f6044f02-2a0c-5fcf-aa58-bfc0ee14e95a"))
