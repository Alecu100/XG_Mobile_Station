(text "USB Hub and Downstream Ports" (at 12 15 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid "1b4c7b24-548d-558c-848a-4fdd055efaac"))
(text "Named nets connect the circuit blocks on this sheet and across the hierarchy." (at 12 23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6d38520c-46bf-5149-8ce3-69748ff26d94"))
(text "USB7206C - six downstream ports" (at 12.0 45 0) (effects (font (size 2 2)) (justify left top)) (uuid "6350700d-f984-5061-ae70-a2e01537bcc6"))
(text "Port 1/2: Type-C. Ports 3/4/5: Type-A SuperSpeed. Port 6: Type-A USB 2.0.\nConfiguration 3 per DS00003850F Tables 3-4/3-5. RESET and VBUS_DET driven by PD MCU, not high-voltage VBUS." (at 12.0 52 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "ec27fc30-efd0-5156-8fbb-945489ca75a3"))
(text "Hub decoupling and transmit coupling" (at 596.2 45 0) (effects (font (size 2 2)) (justify left top)) (uuid "1c50fb65-8d0f-5756-86c7-55320f2178fd"))
(text "One 100 nF capacitor per VDD33/VCORE pin, placed at the relevant pin. Bulk capacitors near hub.\n220 nF series capacitors on each hub SuperSpeed TX lane only. Route 90 ohm differential pairs without stubs." (at 596.2 52 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "8774caaf-4707-567a-98b1-aa2b74586d2e"))
(text "Downstream Type-C 1 - 5 V / 3 A" (at 596.2 316.8 0) (effects (font (size 2 2)) (justify left top)) (uuid "34388d71-908f-5c81-adce-19abe8ce773d"))
(text "HD3SS3220 GPIO mode: ADDR open, PORT high, CURRENT_MODE 10k to 5 V.\nVBUS enable = hub PRT_CTL AND attached. DIR has required 200k pull-up. eFuse nominal 3.27 A, latch-off." (at 596.2 323.8 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "dbda9862-d1f3-53df-9505-810301e63615"))
(text "Downstream Type-C 2 - 5 V / 3 A" (at 12.0 426.0200000000001 0) (effects (font (size 2 2)) (justify left top)) (uuid "8216afa2-e56a-5e21-b97d-78fa14522f15"))
(text "HD3SS3220 GPIO mode: ADDR open, PORT high, CURRENT_MODE 10k to 5 V.\nVBUS enable = hub PRT_CTL AND attached. DIR has required 200k pull-up. eFuse nominal 3.27 A, latch-off." (at 12.0 433.0200000000001 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "f604810a-5f6d-527a-a528-f9a9e954b579"))
(text "Downstream Type-A 1 - SuperSpeed / 900 mA" (at 596.2 735.8999999999999 0) (effects (font (size 2 2)) (justify left top)) (uuid "d688acc1-20da-566b-8d54-2c5b5e984ba9"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 596.2 742.8999999999999 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "24d99e5e-d91d-5b99-a6ec-204874424b89"))
(text "Downstream Type-A 2 - SuperSpeed / 900 mA" (at 12.0 845.1199999999999 0) (effects (font (size 2 2)) (justify left top)) (uuid "2e7e3f78-337b-5aac-b146-fe8ac9cc76b6"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 12.0 852.1199999999999 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "107b7fcc-c1ee-5216-930e-d49cf6a56ae1"))
(text "Downstream Type-A 3 - SuperSpeed / 900 mA" (at 596.2 931.4799999999999 0) (effects (font (size 2 2)) (justify left top)) (uuid "222daec1-c54e-5a1d-a7b7-2570eac971d3"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 596.2 938.4799999999999 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "99ec523c-c5c6-5415-9a5c-413e04b3ac77"))
(text "Downstream Type-A 4 - USB 2.0 / 500 mA" (at 12.0 1040.7 0) (effects (font (size 2 2)) (justify left top)) (uuid "a83c864f-4f5b-5c41-90da-6f9de2ee63f5"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 12.0 1047.7 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "4c13a2ec-f3c4-54fe-a0e7-586468ae273c"))
