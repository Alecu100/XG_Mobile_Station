(text "USB Hub and Downstream Ports" (at 12 15 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid "1b4c7b24-548d-558c-848a-4fdd055efaac"))
(text "Named nets connect the circuit blocks on this sheet and across the hierarchy." (at 12 23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6d38520c-46bf-5149-8ce3-69748ff26d94"))
(text "USB7206C - six downstream ports" (at 12.0 45 0) (effects (font (size 2 2)) (justify left top)) (uuid "6350700d-f984-5061-ae70-a2e01537bcc6"))
(text "Port 1/2: Type-C. Ports 3/4/5: Type-A SuperSpeed. Port 6: Type-A USB 2.0.\nConfiguration 3 per DS00003850F Tables 3-4/3-5. RESET and VBUS_DET driven by PD MCU, not high-voltage VBUS." (at 12.0 52 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "ec27fc30-efd0-5156-8fbb-945489ca75a3"))
(text "Hub decoupling and transmit coupling" (at 596.2 45 0) (effects (font (size 2 2)) (justify left top)) (uuid "1c50fb65-8d0f-5756-86c7-55320f2178fd"))
(text "One 100 nF capacitor per VDD33/VCORE pin, placed at the relevant pin. Bulk capacitors near hub.\n220 nF series capacitors on each hub SuperSpeed TX lane only. Route 90 ohm differential pairs without stubs." (at 596.2 52 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "8774caaf-4707-567a-98b1-aa2b74586d2e"))
(text "Downstream Type-C 1 - 5 V / 3 A" (at 596.2 316.8 0) (effects (font (size 2 2)) (justify left top)) (uuid "34388d71-908f-5c81-adce-19abe8ce773d"))
(text "HD3SS3220 GPIO mode: ADDR open, PORT high, CURRENT_MODE 10k to 5 V.\nVBUS enable = hub PRT_CTL AND attached. DIR has required 200k pull-up. eFuse nominal 3.27 A, latch-off." (at 596.2 323.8 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "dbda9862-d1f3-53df-9505-810301e63615"))
(text "Downstream Type-C 2 - 5 V / 3 A" (at 12.0 492.0600000000001 0) (effects (font (size 2 2)) (justify left top)) (uuid "cbb3e7bd-d816-5877-bf40-b62a9669f8e1"))
(text "HD3SS3220 GPIO mode: ADDR open, PORT high, CURRENT_MODE 10k to 5 V.\nVBUS enable = hub PRT_CTL AND attached. DIR has required 200k pull-up. eFuse nominal 3.27 A, latch-off." (at 12.0 499.0600000000001 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "3ef0ff83-83ad-5652-8365-f01de3fca5c6"))
(text "Downstream Type-A 1 - SuperSpeed / 900 mA" (at 596.2 772.7299999999999 0) (effects (font (size 2 2)) (justify left top)) (uuid "8dc08506-312d-5716-902e-65d3636eb9ac"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 596.2 779.7299999999999 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "49dbbde1-1dbf-5d96-b651-e5fe27975ce8"))
(text "Downstream Type-A 2 - SuperSpeed / 900 mA" (at 12.0 947.9899999999999 0) (effects (font (size 2 2)) (justify left top)) (uuid "9574abbe-7b05-5eb9-aeaf-138418a440a9"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 12.0 954.9899999999999 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "6ed98f44-a4c6-52c7-922c-2f78a767e564"))
(text "Downstream Type-A 3 - SuperSpeed / 900 mA" (at 596.2 977.1999999999999 0) (effects (font (size 2 2)) (justify left top)) (uuid "76a6d64e-e212-557c-8d26-6fc64ea0f348"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 596.2 984.1999999999999 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "d611646c-9be1-5fac-8dfa-eac3c667624b"))
(text "Downstream Type-A 4 - USB 2.0 / 500 mA" (at 12.0 1152.4599999999998 0) (effects (font (size 2 2)) (justify left top)) (uuid "e66e662f-406e-5b87-a3bf-d4c79298e49e"))
(text "TPS259470L provides per-port overcurrent protection and reverse-current blocking.\nFLT_N returns to the hub combined PRT_CTL/overcurrent pin. BC1.2 disabled. Connector selection/footprint pending." (at 12.0 1159.4599999999998 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "8538de41-86c3-5687-8485-d1c8dea59158"))
